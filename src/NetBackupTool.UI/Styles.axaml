<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
  </Style>

  <!-- Cartões -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <!-- Texto -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="TextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
  </Style>

  <!-- Navegação lateral -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>

  <!-- Abas de baixo (celular) -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>
  <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>

  <!-- Margem das telas (no XAML não pode ter Margin local, senão o estilo do celular não vale) -->
  <Style Selector="StackPanel.page">
    <Setter Property="Margin" Value="32,28" />
  </Style>
  <!-- Celular: menos margem em volta das telas -->
  <Style Selector=".compact StackPanel.page">
    <Setter Property="Margin" Value="14,14" />
  </Style>
  <Style Selector=".compact TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
  </Style>

  <!-- Controles ao lado do texto: no celular descem para baixo dele -->
  <Style Selector="StackPanel.sideCol">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector=".compact StackPanel.sideCol">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,14,0,0" />
  </Style>
  <Style Selector="ComboBox.setting">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Width" Value="280" />
  </Style>
  <Style Selector=".compact ComboBox.setting">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="Width" Value="NaN" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="NumericUpDown.setting">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Width" Value="140" />
  </Style>
  <Style Selector="Image.aboutIcon">
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Setter Property="Margin" Value="0,0,20,0" />
  </Style>
  <Style Selector=".compact Image.aboutIcon">
    <Setter Property="DockPanel.Dock" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector=".compact NumericUpDown.setting">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <Style Selector=".compact TextBox.digit">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="48" />
  </Style>

  <Style Selector="StackPanel.codebox">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector=".compact StackPanel.codebox">
    <Setter Property="Spacing" Value="5" />
  </Style>

  <!-- Botões em geral um pouco mais arredondados -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="Padding" Value="28,11" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <!-- Ação discreta, com cara de link -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>

  <!-- Receptores encontrados: "chips" selecionáveis -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
  </Style>

  <!-- Botões de permissão "Sem acesso | Ler | Ler e editar" -->
  <Style Selector="ToggleButton.seg">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>

  <!-- Indicador de estado -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
  </Style>
  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource OkBg}" />
  </Style>
  <Style Selector="Border.pill.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
  </Style>

  <Style Selector="Ellipse.dot">
    <Setter Property="Fill" Value="{DynamicResource MutedText}" />
  </Style>
  <Style Selector="Ellipse.dot.on">
    <Setter Property="Fill" Value="#2EAD5B" />
  </Style>

  <!-- "Detalhes" no mesmo visual dos cartões -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Caixas do código de 6 dígitos -->
  <Style Selector="TextBox.digit">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="50" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MaxLength" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
