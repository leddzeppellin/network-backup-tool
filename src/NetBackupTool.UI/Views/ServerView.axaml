<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NetBackupTool"
             x:Class="NetBackupTool.ServerView">
  <DockPanel>
    <!-- Barra de "Aplicar": aparece quando há mudanças no rascunho -->
    <Border x:Name="ApplyBar" DockPanel.Dock="Bottom" IsVisible="False" Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="32,12">
      <DockPanel MaxWidth="980">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="DiscardButton" Content="{l:T srv.discard}" />
          <Button x:Name="ApplyButton" Classes="accent" Content="{l:T srv.apply}" MinWidth="110" HorizontalContentAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ApplyText" Text="{l:T srv.pending}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Classes="page" Spacing="16" MaxWidth="980">
        <StackPanel Spacing="2">
          <TextBlock Classes="h1" Text="{l:T nav.server}" />
          <TextBlock Classes="muted" Text="{l:T srv.subtitle}" />
        </StackPanel>

        <!-- Qual servidor o painel está administrando -->
        <DockPanel x:Name="RemoteBar">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OtherServerButton" Classes="link" Content="{l:T rem.other}" />
            <Button x:Name="RemoteDisconnectButton" Content="{l:T rem.disconnect}" IsVisible="False" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse x:Name="RemoteDot" Classes="dot on" Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock x:Name="RemoteText" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <!-- Conectar a um servidor de outro PC -->
        <Border x:Name="RemoteCard" Classes="card" IsVisible="False">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="{l:T rem.title}" />
            <TextBlock Classes="muted" Text="{l:T rem.text}" TextWrapping="Wrap" />
            <StackPanel Spacing="6">
              <DockPanel>
                <Button x:Name="RemoteSearchButton" DockPanel.Dock="Right" Content="{l:T sta.searchAgain}" Padding="10,4" FontSize="12" />
                <TextBlock Classes="caption" Text="{l:T sta.found}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="RemoteSearchingText" Classes="muted" Text="{l:T sta.searching}" />
              <WrapPanel x:Name="RemoteChips" />
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MaxWidth="380" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T sta.server}" />
                <TextBox x:Name="RemoteHostBox" Watermark="{l:T sta.serverHint}" Margin="0,0,0,8" />
                <TextBlock Text="{l:T rem.user}" />
                <TextBox x:Name="RemoteUserBox" Watermark="{l:T rem.userHint}" />
                <TextBlock Classes="caption" Text="{l:T rem.userNote}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{l:T srv.password}" />
                <TextBox x:Name="RemotePasswordBox" PasswordChar="●" Classes="revealPasswordButton" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="RemoteConnectButton" Classes="accent" Content="{l:T sta.connect}" MinWidth="120" HorizontalContentAlignment="Center" />
              <Button x:Name="RemoteCancelButton" Content="{l:T rem.backLocal}" />
              <TextBlock x:Name="RemoteStatus" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ProblemText" Classes="muted" Foreground="IndianRed" IsVisible="False" />

        <StackPanel x:Name="ServerContent" Spacing="16">
        <!-- Pasta da empresa e endereço -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock x:Name="SetupTitle" Classes="h2" Text="{l:T srv.setupTitle}" />
            <TextBlock x:Name="SetupText" Classes="muted" Text="{l:T srv.setupText}" />
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <TextBlock Text="{l:T srv.root}" VerticalAlignment="Center" />
              <TextBlock x:Name="RootText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox x:Name="RootPathBox" Grid.Column="1" Watermark="{l:T rem.rootHint}" IsVisible="False" />
              <Button x:Name="ChooseRootButton" Grid.Column="2" Content="{l:T srv.chooseRoot}" />
              <TextBlock Grid.Row="1" Text="{l:T srv.shareName}" VerticalAlignment="Center" />
              <TextBox x:Name="ShareNameBox" Grid.Row="1" Grid.Column="1" MaxWidth="260" HorizontalAlignment="Left" Width="260" />
              <TextBlock Grid.Row="2" Text="{l:T srv.address}" VerticalAlignment="Center" />
              <SelectableTextBlock x:Name="AddressText" Grid.Row="2" Grid.Column="1" Classes="code" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Abas -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton x:Name="TabOverview" Classes="chip" Content="{l:T srv.tabOverview}" />
          <ToggleButton x:Name="TabFolders" Classes="chip" Content="{l:T srv.tabFolders}" />
          <ToggleButton x:Name="TabPeople" Classes="chip" Content="{l:T srv.tabPeople}" />
          <ToggleButton x:Name="TabActivity" Classes="chip" Content="{l:T act.tab}" />
        </StackPanel>

        <!-- Visão geral -->
        <StackPanel x:Name="OverviewPanel" Spacing="12">
          <UniformGrid Columns="3">
            <Border Classes="card" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="{l:T srv.connected}" />
                <TextBlock x:Name="SessionsText" FontSize="24" FontWeight="SemiBold" Text="—" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="4,0,4,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="{l:T srv.openFiles}" />
                <TextBlock x:Name="OpenCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="{l:T srv.peopleCount}" />
                <TextBlock x:Name="PeopleCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T srv.openFiles}" />
              <TextBlock x:Name="NoOpenFiles" Classes="muted" Text="{l:T srv.noOpenFiles}" />
              <StackPanel x:Name="OpenFilesList" Spacing="6" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Pastas -->
        <Grid x:Name="FoldersPanel" ColumnDefinitions="230,*" ColumnSpacing="12" IsVisible="False">
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <StackPanel x:Name="FolderList" Spacing="2" />
              <TextBox x:Name="NewFolderBox" Watermark="{l:T srv.newFolder}" Margin="0,8,0,0" />
              <Button x:Name="AddFolderButton" Content="{l:T srv.add}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
            <StackPanel x:Name="FolderDetail" Spacing="10" />
          </Border>
        </Grid>

        <!-- Atividade: quem criou, alterou ou apagou o quê -->
        <StackPanel x:Name="ActivityPanel" Spacing="12" IsVisible="False">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <CheckBox x:Name="ActivityOn" Content="{l:T act.enable}" />
              <TextBlock Classes="caption" Text="{l:T act.enableNote}" TextWrapping="Wrap" />
              <WrapPanel>
                <ComboBox x:Name="ActivityPeriod" Width="150" Margin="0,0,8,8" SelectedIndex="0">
                  <ComboBoxItem Content="{l:T act.days7}" />
                  <ComboBoxItem Content="{l:T act.days30}" />
                  <ComboBoxItem Content="{l:T act.days365}" />
                </ComboBox>
                <TextBox x:Name="ActivitySearch" Watermark="{l:T act.search}" Width="280" Margin="0,0,8,8" />
                <Button x:Name="ActivityRefresh" Content="{l:T act.refresh}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock x:Name="ActivityEmpty" Classes="muted" Text="{l:T act.empty}" TextWrapping="Wrap" />
              <StackPanel x:Name="ActivityList" Spacing="2" />
              <TextBlock x:Name="ActivityMore" Classes="caption" IsVisible="False" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Pessoas e grupos -->
        <StackPanel x:Name="PeoplePanel" Spacing="12" IsVisible="False">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{l:T srv.groups}" />
              <WrapPanel x:Name="GroupList" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewGroupBox" Watermark="{l:T srv.groupName}" Width="220" />
                <Button x:Name="AddGroupButton" Content="{l:T srv.add}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{l:T srv.people}" />
              <StackPanel x:Name="PeopleList" Spacing="12" />
              <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <WrapPanel>
                  <TextBox x:Name="NewLoginBox" Watermark="{l:T srv.login}" Width="170" Margin="0,0,8,8" />
                  <TextBox x:Name="NewNameBox" Watermark="{l:T srv.fullName}" Width="200" Margin="0,0,8,8" />
                  <TextBox x:Name="NewPasswordBox" Watermark="{l:T srv.password}" PasswordChar="●" Width="170" Margin="0,0,8,8" />
                  <Button x:Name="AddPersonButton" Classes="accent" Content="{l:T srv.addPerson}" Margin="0,0,0,8" />
                </WrapPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
