<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NetBackupTool"
             x:Class="NetBackupTool.StationView">
  <ScrollViewer>
    <StackPanel Classes="page" Spacing="16" MaxWidth="820">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="{l:T nav.company}" />
        <TextBlock x:Name="SubtitleText" Classes="muted" Text="{l:T sta.subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock x:Name="ElevatedText" Classes="muted" Foreground="IndianRed" Text="{l:T sta.elevated}" TextWrapping="Wrap" IsVisible="False" />

      <!-- Ainda não conectado -->
      <Border x:Name="ConnectCard" Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{l:T sta.connectTitle}" />
          <TextBlock x:Name="ConnectText" Classes="muted" Text="{l:T sta.connectText}" TextWrapping="Wrap" />

          <StackPanel Spacing="6">
            <DockPanel>
              <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="{l:T sta.searchAgain}" Padding="10,4" FontSize="12" />
              <TextBlock Classes="caption" Text="{l:T sta.found}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="SearchingText" Classes="muted" Text="{l:T sta.searching}" />
            <WrapPanel x:Name="ServerChips" />
          </StackPanel>

          <!-- Rótulo em cima do campo: cabe igual no celular e no computador -->
          <!-- Coluna com no máximo 380: no celular ocupa a largura toda, no computador não estica demais -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1000*" MaxWidth="380" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="{l:T sta.server}" />
            <TextBox x:Name="ServerBox" Watermark="{l:T sta.serverHint}" TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Margin="0,0,0,8" />
            <TextBlock Text="{l:T srv.shareName}" />
            <TextBox x:Name="ShareBox" Text="Empresa" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Margin="0,0,0,8" />
            <TextBlock Text="{l:T srv.login}" />
            <TextBox x:Name="LoginBox" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Margin="0,0,0,8" />
            <TextBlock x:Name="PasswordLabel" Text="{l:T srv.password}" />
            <TextBox x:Name="PasswordBox" PasswordChar="●" Classes="revealPasswordButton" TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" />
          </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ConnectButton" Classes="accent" Content="{l:T sta.connect}" MinWidth="120" HorizontalContentAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Conectado -->
      <StackPanel x:Name="ConnectedPanel" Spacing="16" IsVisible="False">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Classes="dot on" Width="10" Height="10" VerticalAlignment="Center" />
              <TextBlock x:Name="ConnectedTitle" Classes="h2" />
            </StackPanel>
            <TextBlock x:Name="ConnectedText" Classes="muted" TextWrapping="Wrap" />
            <WrapPanel>
              <Button x:Name="OpenButton" Classes="accent" Content="{l:T sta.open}" Margin="0,0,8,0" />
              <Button x:Name="RefreshButton" Content="{l:T sta.refresh}" Margin="0,0,8,0" />
              <Button x:Name="DisconnectButton" Content="{l:T sta.disconnect}" />
            </WrapPanel>
            <TextBlock x:Name="OfflineText" Classes="muted" Foreground="IndianRed" Text="{l:T sta.offline}" TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{l:T sta.yourFolders}" />
            <TextBlock x:Name="NoFoldersText" Classes="muted" Text="{l:T sta.noFolders}" TextWrapping="Wrap" IsVisible="False" />
            <StackPanel x:Name="FolderList" Spacing="4" />
            <TextBlock Classes="caption" Text="{l:T sta.pinsNote}" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Celular: navegador das pastas dentro do app -->
      <StackPanel x:Name="BrowserPanel" Spacing="12" IsVisible="False">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button x:Name="UpButton" DockPanel.Dock="Left" Padding="10,4" Margin="0,0,10,0" IsVisible="False">
                <TextBlock Text="‹" FontSize="20" Margin="0,-4,0,0" />
              </Button>
              <TextBlock x:Name="PathText" Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <WrapPanel>
              <Button x:Name="UploadButton" Classes="accent" Content="{l:T sta.upload}" Margin="0,0,8,8" />
              <Button x:Name="NewFolderButton" Content="{l:T sta.newFolder}" Margin="0,0,8,8" />
              <Button x:Name="BrowserDisconnectButton" Content="{l:T sta.disconnect}" Margin="0,0,8,8" />
            </WrapPanel>
            <DockPanel x:Name="NewFolderRow" IsVisible="False">
              <Button x:Name="CreateFolderButton" DockPanel.Dock="Right" Classes="accent" Content="{l:T sta.create}" Margin="8,0,0,0" />
              <TextBox x:Name="NewFolderNameBox" Watermark="{l:T srv.newFolder}" />
            </DockPanel>
            <TextBlock x:Name="RootHint" Classes="muted" Text="{l:T sta.rootHint}" TextWrapping="Wrap" IsVisible="False" />
            <TextBlock x:Name="BrowserStatus" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="6">
          <StackPanel>
            <TextBlock x:Name="EmptyText" Classes="muted" Text="{l:T sta.empty}" Margin="12" IsVisible="False" />
            <StackPanel x:Name="EntryList" />
          </StackPanel>
        </Border>
        <TextBlock Classes="caption" Text="{l:T sta.editNote}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Técnico: administrar o servidor da empresa a partir deste PC -->
      <Button x:Name="AdminServerButton" Classes="link" Content="{l:T rem.adminLink}" HorizontalAlignment="Left" IsVisible="False" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
