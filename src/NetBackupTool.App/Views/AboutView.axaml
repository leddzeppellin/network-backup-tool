<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NetBackupTool"
             x:Class="NetBackupTool.AboutView">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="16" MaxWidth="760">
      <TextBlock Classes="h1" Text="{l:T nav.about}" />

      <Border Classes="card" Padding="22,20">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="/Assets/icon.png" Width="84" Height="84" Margin="0,0,20,0" VerticalAlignment="Top" />
          <StackPanel Spacing="6">
            <TextBlock Text="Network Backup Tool" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Classes="muted" />
            <TextBlock Text="{l:T about.desc}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{l:T about.license}" />
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="UpdateButton" Classes="accent" Content="{l:T menu.update}" Margin="0,0,8,8" />
              <Button x:Name="ProjectButton" Content="{l:T menu.project}" Margin="0,0,8,8" />
              <Button x:Name="ReportsButton" Content="{l:T menu.reports}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock x:Name="UpdateStatus" Classes="caption" IsVisible="False" />
            <ProgressBar x:Name="UpdateProgress" Maximum="100" IsVisible="False" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{l:T howto.title}" />
          <SelectableTextBlock Text="{l:T howto.text}" TextWrapping="Wrap" LineHeight="22" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
