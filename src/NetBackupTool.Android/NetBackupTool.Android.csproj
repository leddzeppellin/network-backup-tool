<Project Sdk="Microsoft.NET.Sdk">

  <!-- App Android (APK para o GitHub; AAB para a Play Store com -p:AndroidPackageFormat=aab). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetBackupTool.Droid</RootNamespace>
    <AssemblyName>NetBackupTool.Android</AssemblyName>
    <ApplicationId>io.github.leddzeppellin.netbackuptool</ApplicationId>
    <ApplicationTitle>Network Backup Tool</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- versionCode inteiro e crescente: 2.2.0 → 20200 (mínimo 1: o Android recusa 0) -->
    <ApplicationVersion>$([System.Math]::Max(1, $([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 10000)), $([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Minor), 100)), $([System.Version]::Parse('$(Version)').Build)))))))</ApplicationVersion>
    <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- O pacote .aab é o da Play Store: lá as atualizações vêm só pela loja. -->
  <PropertyGroup Condition="'$(AndroidPackageFormat)' == 'aab'">
    <DefineConstants>$(DefineConstants);PLAYSTORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <!-- SkiaSharp 3: bibliotecas nativas alinhadas a páginas de 16 KB (exigência da Play Store / Android 15+). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetBackupTool.UI\NetBackupTool.UI.csproj" />
  </ItemGroup>

</Project>
